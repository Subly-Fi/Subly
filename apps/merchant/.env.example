# Merchant dashboard (Vite) environment. Only VITE_-prefixed vars are exposed.

# Subly backend API (apps/api) — merchant auth, profile, analytics.
VITE_SUBLY_API_URL=http://localhost:3002

# Local dev webapp API (config / airdrop / setup / program-deploy helpers).
VITE_API_URL=http://localhost:3001

# Default cluster: localnet | devnet | testnet | mainnet
VITE_DEFAULT_CLUSTER=devnet

# Mainnet RPC override (defaults to a public endpoint if unset).
VITE_MAINNET_RPC_URL=

# Localnet-only overrides for surfnet/local validator testing.
VITE_LOCALNET_PROGRAM=
VITE_LOCALNET_USDC_MINT=
