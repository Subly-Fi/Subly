# Merchant dashboard (Vite) environment. Only VITE_-prefixed vars are exposed.
# For production, set these as Vercel env vars on the subly-merchant project.

# Subly backend API (apps/api) — merchant auth, profile, analytics.
# Production: your deployed API URL, e.g. https://subly-api.vercel.app
VITE_SUBLY_API_URL=http://localhost:3002

# Local dev webapp API (config / airdrop / setup / program-deploy helpers).
# Only used in DEV; leave as-is for production.
VITE_API_URL=http://localhost:3001

# Default cluster: solana:localnet | solana:devnet | solana:mainnet
# MAINNET launch:
VITE_DEFAULT_CLUSTER=solana:mainnet
# Devnet alternative: VITE_DEFAULT_CLUSTER=solana:devnet

# Subly collector ("puller") wallet address. MUST equal the API's
# SUBLY_SIGNER_ADDRESS. Enables the "Subly collects automatically" toggle.
VITE_SUBLY_PULLER_ADDRESS=

# Base URL for generated checkout/share links (the deployed marketing site).
VITE_CHECKOUT_BASE_URL=https://www.subly.fi

# Mainnet RPC override (defaults to a public endpoint if unset).
# IMPORTANT: ships in the browser bundle. Use a DOMAIN-RESTRICTED Helius key
# (Access Control Rules → allow your merchant + subly.fi domains), NOT the
# backend key. Helius free tier is enough to launch.
VITE_MAINNET_RPC_URL=

# Localnet-only overrides for surfnet/local validator testing (demo script sets these).
VITE_LOCALNET_PROGRAM=
VITE_LOCALNET_USDC_MINT=
