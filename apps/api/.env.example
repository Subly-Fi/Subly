# ── Subly backend API (apps/api) ─────────────────────────────────────────────
# Copy to .env.local for local dev. In production set these as Vercel env vars.

# Network / RPC the indexer + collector target.
# Devnet launch (recommended first):
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Mainnet launch: swap to your mainnet RPC (a paid RPC is strongly recommended).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Program id — MUST match the merchant/web config and the on-chain program.
PROGRAM_ADDRESS=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44

# ── Supabase ──
SUPABASE_URL=https://jjfnnzdpicwtcivgmrgh.supabase.co
# service_role key (Dashboard → Project Settings → API Keys). SECRET — never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / cron secrets (required in production) ──
# Generate with: openssl rand -hex 32
JWT_SECRET=
CRON_SECRET=

# ── Subly collector ("puller") wallet ──
# Generate: solana-keygen new -o subly-signer.json --no-bip39-passphrase
# SECRET_KEY is the JSON byte array from that file. ADDRESS is its pubkey and
# must equal the merchant app's VITE_SUBLY_PULLER_ADDRESS.
SUBLY_SIGNER_SECRET_KEY=
SUBLY_SIGNER_ADDRESS=

# ── Email (Resend) — optional; dunning/receipt emails are skipped if unset ──
RESEND_API_KEY=

# ── Queue (Upstash QStash) — optional; webhooks dispatch inline if unset ──
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Inbound webhooks (optional) ──
# Shared secret for POST /webhooks/* (X-Subly-Secret header). Unset = disabled.
INBOUND_WEBHOOK_SECRET=

# ── CORS (optional) ──
# Extra browser origins allowed to call the API, comma-separated. Defaults
# already include localhost, subly.fi, and subly-merchant.vercel.app. Add your
# merchant deployment URL here if it differs.
# CORS_ORIGINS=https://your-merchant-domain.com

# ── Local/persistent hosting only ──
# Set to 'false' to disable the persistent poll-loop indexer (e.g. on serverless,
# where /cron/index is driven by a scheduler instead).
# ENABLE_INDEXER=false
# PORT=3002
