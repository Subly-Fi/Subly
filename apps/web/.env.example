# ── Subly marketing site + hosted checkout (apps/web) ────────────────────────
# Set these as Vercel env vars on the subly-web project.

# Where subly.fi/app redirects (the deployed merchant dashboard).
NEXT_PUBLIC_APP_URL=https://subly-merchant.vercel.app

# Program id — MUST match the merchant + api config.
NEXT_PUBLIC_PROGRAM_ADDRESS=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44

# RPC the checkout uses. The checkout picks the network from the share link's
# ?network= param; these provide the URL per network.
# IMPORTANT: this value ships in the browser bundle. Use a DOMAIN-RESTRICTED
# Helius key (Access Control Rules → allow subly.fi) — never the backend key.
# NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_FRONTEND_KEY
# NEXT_PUBLIC_LOCALNET_RPC_URL=http://127.0.0.1:8899
