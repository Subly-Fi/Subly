# ── Solana ──
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_PROGRAM_ADDRESS=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=

# ── Queue (Upstash QStash) ──
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── App URLs ──
NEXT_PUBLIC_APP_URL=https://app.subly.fi

# ── Vercel ──
VERCEL_URL=

# ── Solana RPC (backend / apps/api) ──
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Program id the indexer/collector target. MUST match NEXT_PUBLIC_PROGRAM_ADDRESS
# (and the on-chain crate id); leave unset only to fall back to the client default.
PROGRAM_ADDRESS=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44

# ── Subly Signer (payment collector wallet) ──
SUBLY_SIGNER_SECRET_KEY=
SUBLY_SIGNER_ADDRESS=

# ── API auth & security (apps/api) ──
# Required in production (the server refuses to boot without JWT_SECRET/CRON_SECRET).
JWT_SECRET=
CRON_SECRET=
# Shared secret for inbound POST /webhooks/* (sent as the X-Subly-Secret header).
# Unset = those endpoints are disabled (the on-chain indexer is the source of truth).
INBOUND_WEBHOOK_SECRET=

# ── Subly ──
NEXT_PUBLIC_SUBLY_TOKEN_MINT=FwiaNTvgRCHEZGeKAfwcSE5KDxmh7jJPssT1pWqVpump
